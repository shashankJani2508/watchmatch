# Supabase — get from supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# TMDB — get the Read Access Token from themoviedb.org > Settings > API
TMDB_API_READ_ACCESS_TOKEN=eyJ...

# RapidAPI — subscribe to "Streaming Availability" by Movie of the Night
# at rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
RAPIDAPI_KEY=your-rapidapi-key

# Your deployed URL (used for QR code links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
