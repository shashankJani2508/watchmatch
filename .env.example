# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ── Supabase ────────────────────────────────────────────────
# supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Realtime is off by default: it rejects the sb_publishable_ key format and the
# app polls instead. Set to "true" only with a legacy JWT anon key.
# NEXT_PUBLIC_SUPABASE_REALTIME=true

# ── Gemini (genre briefs) ───────────────────────────────────
# aistudio.google.com > API keys
GEMINI_API_KEY=xxxxxxxxxxxx
GEMINI_MODEL=gemini-3.6-flash

# ── TMDB (titles, posters, streaming availability) ──────────
# themoviedb.org > Settings > API > API Read Access Token
TMDB_API_READ_ACCESS_TOKEN=eyJhbGciOi...

# ── App ─────────────────────────────────────────────────────
# Used for the QR code / invite link. Your deployed URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: Neon Postgres fallback ────────────────────────
# Only used when the Supabase vars above are absent.
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
