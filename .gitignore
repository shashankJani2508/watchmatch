.env
.env.*
!.env.example

# Vercel
.vercel

# Stale duplicate copy of the project, not part of the build
/watchmatch/

# Logs and OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db
tsconfig.tsbuildinfo
